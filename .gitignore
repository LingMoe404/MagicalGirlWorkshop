# --- 本地配置与运行缓存 ---
config.ini
.env
.env.*
cache/
*.log
*.tmp

# --- Python 环境与字节码 ---
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# --- 开发工具缓存 (Ruff/Mypy) ---
.ruff_cache/
.mypy_cache/
.superpowers/

# --- 代理私有状态（锚定根目录：保留 .agents/skills/ 下的 skill 本身可提交） ---
/.agent-state/
/.harness-state/
/auth.json
/memories/
/.agents/auth.json
/.agents/logs/
/.agents/history/
/.agents/memories/
/.zcode/auth.json
/.zcode/logs/
/.zcode/history/
/.zcode/memories/
# .normalizer 必须写成不带前导 / 的形式：checker 用 line.rstrip('/') == '.normalizer'
# 精确比对，锚定形式 /.normalizer/ 无法通过它自己的 cache 门禁。
.normalizer/

# --- Nuitka 打包产物与构建目录 (强化防御) ---
build/
*.build/
*.dist/
*.onefile-build/

# --- 最终编译的实体结晶 (防止污染源码仓库) ---
*.exe
*.7z
*.zip

# --- IDE 与操作系统缓存 (抵御异次元干扰) ---
.vscode/
.idea/
.history/
.DS_Store
Thumbs.db
